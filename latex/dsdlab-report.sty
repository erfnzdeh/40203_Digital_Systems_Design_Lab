\newcommand{\reporttitlepage}[2]{%
  \hypersetup{pageanchor=false}
  \begin{titlepage}
    \thispagestyle{empty}
    \linespread{1.12}\selectfont
    \begin{center}
      \vspace*{0.6cm}
      {\Large\bfseries \reportuniversity\par}
      \vspace{0.25cm}
      {\large \reportdepartment\par}

      \vfill

      {\huge\bfseries گزارش آزمایش #1\par}
      \vspace{0.45cm}
      {\LARGE\bfseries #2\par}
      \vspace{0.9cm}
      \begin{latin}
        {\Large\bfseries \reportenglishtitle\par}
      \end{latin}

      \vfill

      {\large اعضای گروه\par}
      \vspace{0.4cm}
      {\large\bfseries
        \begin{tabular}{rl}
          \reportmembers
        \end{tabular}\par
      }

      \vspace{0.9cm}
      {\large نام درس\par}
      \vspace{0.25cm}
      {\Large\bfseries \reportcourse\par}

      \vspace{0.7cm}
      {\large استاد درس\par}
      \vspace{0.25cm}
      {\Large\bfseries \reportinstructor\par}

      \vspace{0.7cm}
      {\large\bfseries \reportsemester\par}
      \vspace*{0.4cm}
    \end{center}
  \end{titlepage}
  \clearpage
  \hypersetup{pageanchor=true}
  \pagestyle{plain}
  \pagenumbering{arabic}
}

\newcommand{\shot}[2]{%
  \begin{figure}[H]
    \centering
    \includegraphics[width=0.95\linewidth]{#1}
    \caption{#2}
  \end{figure}
}

\newcommand{\shotw}[3]{%
  \begin{figure}[H]
    \centering
    \includegraphics[width=#2\linewidth]{#1}
    \caption{#3}
  \end{figure}
}

\definecolor{codeback}{HTML}{F7F7F7}
\definecolor{coderule}{HTML}{BFBFBF}
\definecolor{codekey}{HTML}{0B3C8C}
\definecolor{codecomment}{HTML}{2E7D32}
\definecolor{codestring}{HTML}{9C4221}
\definecolor{codenumber}{HTML}{808080}

\lstdefinestyle{dsdcode}{
  basicstyle=\ttfamily\scriptsize\linespread{1}\selectfont,
  keywordstyle=\color{codekey}\bfseries,
  commentstyle=\color{codecomment}\itshape,
  stringstyle=\color{codestring},
  numbers=left,
  firstnumber=1,
  numberstyle=\ttfamily\tiny\color{codenumber},
  numbersep=9pt,
  backgroundcolor=\color{codeback},
  frame=single,
  rulecolor=\color{coderule},
  framesep=5pt,
  showstringspaces=false,
  breaklines=true,
  breakatwhitespace=true,
  columns=fullflexible,
  keepspaces=true,
  tabsize=4,
  xleftmargin=2.2em,
  xrightmargin=0.4em,
  aboveskip=0.9em,
  belowskip=0.4em,
}

\lstdefinelanguage{TclScript}{
  morekeywords={vlib,vmap,vlog,vcom,vdel,vsim,add,wave,run,view,quit,restart,force,radix,
    configure,transcript,do,if,else,set,proc,quietly,create_clock,get_ports,
    derive_clock_uncertainty,set_input_delay,set_output_delay},
  morecomment=[l]{\#},
  morestring=[b]",
  sensitive=true,
}

% \vcode[<listings options>]{<file>}{<caption>}
\newcommand{\vcode}[3][]{%
  \par\addvspace{0.7em}%
  \begin{latin}%
    \lstinputlisting[style=dsdcode,language=Verilog,#1]{#2}%
  \end{latin}%
  \par\nobreak
  \captionof{code}{#3}%
  \addvspace{0.7em}%
}

% \docode[<listings options>]{<file>}{<caption>}
\newcommand{\docode}[3][]{%
  \par\addvspace{0.7em}%
  \begin{latin}%
    \lstinputlisting[style=dsdcode,language=TclScript,numbers=none,#1]{#2}%
  \end{latin}%
  \par\nobreak
  \captionof{code}{#3}%
  \addvspace{0.7em}%
}

